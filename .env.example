ASSISTANT_POST_MODE=dry-run
ASSISTANT_TIMEZONE=UTC
ASSISTANT_SCHEDULE_TIMES=09:00,13:00,18:00
ASSISTANT_POSTS_FILE=posts.txt
# Alternative to ASSISTANT_POSTS_FILE:
# ASSISTANT_POSTS_JSON=["A custom post","Another post with {date}"]
ASSISTANT_POST_SELECTION=sequential
ASSISTANT_STATE_FILE=.assistant_state.json
ASSISTANT_MAX_POST_LENGTH=280
ASSISTANT_RUN_ONCE_ON_START=false
ASSISTANT_EXIT_AFTER_RUN_ONCE=false

# Required only when ASSISTANT_POST_MODE=live
X_API_KEY=
X_API_KEY_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
