# ─── Telegram Bot ─────────────────────────────────────────────
# Get your bot token from @BotFather on Telegram (/newbot)
TELEGRAM_BOT_TOKEN=

# Your Telegram user ID (message @userinfobot to find it)
TELEGRAM_CHAT_ID=

# Comma-separated Telegram user IDs allowed to use the bot
ADMIN_IDS=

# ─── X (Twitter) API credentials ─────────────────────────────
# Get FREE keys at: https://developer.x.com
# 1. Sign in with your X account
# 2. Create a project + app
# 3. Set app permissions to "Read and Write"
# 4. Generate Access Token & Secret
#
# Free tier = 17 posts per 24 hours per account
# Add Account 2 to double to 34 posts/day — still FREE

# Account 1
X_API_KEY_1=
X_API_SECRET_1=
X_ACCESS_TOKEN_1=
X_ACCESS_TOKEN_SECRET_1=

# Account 2 (optional — adds another 17 posts/day for free)
X_API_KEY_2=
X_API_SECRET_2=
X_ACCESS_TOKEN_2=
X_ACCESS_TOKEN_SECRET_2=

# Account 3 (optional — 51 posts/day total)
# X_API_KEY_3=
# X_API_SECRET_3=
# X_ACCESS_TOKEN_3=
# X_ACCESS_TOKEN_SECRET_3=
